print("缺失值比例超过20%的变量:")
for(var in high_na_vars) {
print(paste(var, ":", round(na_proportions[var] * 100, 2), "%"))}
# 创建描述性统计表格
tbl1 <- table1(~ age + gender + address_type + address_urban_or_rural +
literate + martial_status + education_level + num_children_married +
number_grandchildren_great_grandchildren + number_medical_insurance +
number_chronic_disease + health_compared + number_pain_locations,
data = my_data_imputed)
print(tbl1)
# 确保分类变量被正确识别为因子类型
covered_individuals$final_physical_score <- as.factor(covered_individuals$final_physical_score)
covered_individuals$cognitive_level <- as.factor(covered_individuals$cognitive_level)
covered_individuals$final_psychological_score <- as.factor(covered_individuals$final_psychological_score)
covered_individuals$final_sensory_score <- as.factor(covered_individuals$final_sensory_score)
covered_individuals$final_vitality_score <- as.factor(covered_individuals$final_vitality_score)
# 定义标签，使表格更易读（可选）
label(covered_individuals$final_physical_score) <- "最终身体评分"
label(covered_individuals$cognitive_level) <- "认知水平"
label(covered_individuals$final_psychological_score) <- "最终心理评分"
label(covered_individuals$final_sensory_score) <- "最终感官评分"
label(covered_individuals$final_vitality_score) <- "最终活力评分"
label(covered_individuals$ic_total_score) <- "IC总分"
# 创建描述性统计表格
result_table <- table1(~ final_physical_score + cognitive_level +
final_psychological_score + final_sensory_score +
final_vitality_score + ic_total_score,
data = covered_individuals)
# 显示表格
print(result_table)
# 检查Boruta包是否已安装
if (!require("Boruta")) {install.packages("Boruta")}
# 加载Boruta包
library(Boruta)
# 检查因子变量的水平数量
single_level_factors <- sapply(my_data_imputed, function(x) {
if (is.factor(x)) length(levels(x)) == 1 else FALSE
})
# 打印只有一个水平的因子变量
print(names(single_level_factors[single_level_factors]))
# 移除只有一个水平的因子变量
my_data_imputed <- my_data_imputed %>%
select(-all_of(names(single_level_factors[single_level_factors])))
dim(my_data_imputed)
# 使用Boruta算法进行变量筛选（Boruta方法应该用在缺失值处理之后还是之前）
set.seed(123)
# 运行Boruta算法
boruta_output <- Boruta(ic_total_score ~ . - ID, data = my_data_imputed, doTrace = 2)
# 获取确定纳入的变量
confirmed_vars <- names(boruta_output$finalDecision[boruta_output$finalDecision == "Confirmed"])
print("确定纳入的变量:")
print(confirmed_vars)
length(confirmed_vars)
# 获取可能纳入的变量
tentative_vars <- names(boruta_output$finalDecision[boruta_output$finalDecision == "Tentative"])
print("可能纳入的变量:")
print(tentative_vars)
length(tentative_vars)
# 获取确定排除的变量
rejected_vars <- names(boruta_output$finalDecision[boruta_output$finalDecision == "Rejected"])
print("确定排除的变量:")
print(rejected_vars)
# 从插值后数据框中提取确认纳入和可能纳入的变量
# 创建一个数据框来存储变量信息
vars_info <- data.frame(
variable_name = c(confirmed_vars, tentative_vars),
status = c(rep("确认纳入", length(confirmed_vars)),
rep("可能纳入", length(tentative_vars)))
)
# 导出变量信息到CSV文件
write.csv(vars_info,
"data_export/data_auto_filter/variables_boruta_filter.csv",
row.names = FALSE,
fileEncoding = "UTF-8")
# 从插值后数据框中提取boruta筛选后的变量
boruta_data <- my_data_imputed %>%
select(
all_of(confirmed_vars),
all_of(tentative_vars),
ic_total_score
)
# 导出提取后的数据框
write_parquet(boruta_data, "data_export/data_auto_filter/my_data_boruta.parquet")
write.csv(boruta_data, "data_export/data_auto_filter/my_data_boruta.csv", row.names = FALSE)
# 构建模型公式，去掉所有pain_开头的变量和其他不需要的变量
model_vif <- lm(ic_total_score ~ . - ic_total_score - literate - number_grandchildren_great_grandchildren - menopause - pain - pain_head - pain_shoulder - pain_arm - pain_wrist - pain_fingers - pain_chest - pain_back - pain_waist - pain_leg - pain_knees - pain_ankle - pain_toes - pain_neck, data = boruta_data)
# 计算VIF值
vif_results <- vif(model_vif)
# 打印VIF结果
print(vif_results)
