# 计算是否有网络（没问题）
my_data_calculated <- my_data_calculated %>%
mutate(
internet = case_when(
is.na(my_data_manual_filtered$i024) ~ NA_real_,
my_data_manual_filtered$i024 == 1 ~ 1,
my_data_manual_filtered$i024 == 2 ~ 0,
TRUE ~ NA_real_
)
)
attr(my_data_calculated$internet, "label") <- "是否有网络"
# 计算是否有空气净化器（没问题）
my_data_calculated <- my_data_calculated %>%
mutate(
air_cleaner = case_when(
is.na(my_data_manual_filtered$i027_w3) ~ NA_real_,
my_data_manual_filtered$i027_w3 == 1 ~ 1,
my_data_manual_filtered$i027_w3 == 2 ~ 0,
TRUE ~ NA_real_
)
)
attr(my_data_calculated$air_cleaner, "label") <- "是否有空气净化器"
# 计算环境友好度（没问题）
my_data_calculated <- my_data_calculated %>%
mutate(
environmentally_friendly = case_when(
# 如果任何一个变量是NA，返回NA
is.na(elevator) |
is.na(handicapped_facilities) |
is.na(steps) |
is.na(toilet_seat) |
is.na(toilet_flushable) |
is.na(running_water) |
is.na(hot_water) |
is.na(gas) |
is.na(heating) |
is.na(telephone) |
is.na(internet) |
is.na(air_cleaner) ~ NA_real_,
# 如果没有NA，计算总和除以12
TRUE ~ (elevator +
handicapped_facilities +
steps +
toilet_seat +
toilet_flushable +
running_water +
hot_water +
gas +
heating +
telephone +
internet +
air_cleaner) / 12
)
)
attr(my_data_calculated$environmentally_friendly, "label") <- "环境友好度"
# 导出环境友好度相关数据
environment_data <- my_data_calculated %>%
select(
ID, elevator, handicapped_facilities, steps,
toilet_seat, toilet_flushable, running_water,
hot_water, gas, heating, telephone, internet,
air_cleaner, environmentally_friendly
)
# 导出环境友好度相关数据为parquet
write_parquet(environment_data, "data_export/data_calculated/parquet/data_calculated_environment.parquet")
# 导出环境友好度相关数据为csv
write.csv(environment_data, "data_export/data_calculated/csv/data_calculated_environment.csv", row.names = FALSE)
