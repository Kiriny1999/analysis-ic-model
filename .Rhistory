is.na(heating) |
is.na(telephone) |
is.na(internet) |
is.na(air_cleaner) ~ NA_real_,
# 如果没有NA，计算总和除以12
TRUE ~ (elevator +
handicapped_facilities +
steps +
toilet_seat +
toilet_flushable +
running_water +
hot_water +
gas +
heating +
telephone +
internet +
